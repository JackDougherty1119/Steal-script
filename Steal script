-- Helper function to identify Mini Fridges and ignore them
local function isMiniFridge(instance)
    local name = instance.Name:lower()
    return name:find("mini fridge") or name:find("minifridge") or name:find("fridge")
end

-- UI Constructor Helper
local function create(className, properties)
    local instance = Instance.new(className)
    for k, v in pairs(properties) do
        instance[k] = v
    end
    return instance
end

