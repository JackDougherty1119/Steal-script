-- Highlight Manager Utility
local function toggleHighlight(target, state, color, name, displayText)
    if state then
        if not target:FindFirstChild(name) then
            create("Highlight", {
                Name = name,
                Adornee = target,
                FillColor = color,
                OutlineColor = Color3.fromRGB(255, 255, 255),
                FillTransparency = 0.3,
                OutlineTransparency = 0,
                Parent = target
            })
        end
        
        if displayText then
            local part = target:IsA("Model") and (target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")) or target
            if part then
                local bill = part:FindFirstChild(name .. "_Info")
                if not bill then
                    bill = create("BillboardGui", { Name = name .. "_Info", Size = UDim2.new(0, 120, 0, 30), StudsOffset = Vector3.new(0, 3, 0), AlwaysOnTop = true, Parent = part })
                    create("TextLabel", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, TextColor3 = color, TextStrokeTransparency = 0, TextSize = 13, Font = Enum.Font.GothamBold, Text = displayText, Parent = bill })
                else
                    local label = bill:FindFirstChildOfClass("TextLabel")
                    if label then label.Text = displayText end
                end
            end
        end
    else
        local hl = target:FindFirstChild(name)
        if hl then hl:Destroy() end
        local part = target:IsA("Model") and (target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")) or target
        if part then
            local bill = part:FindFirstChild(name .. "_Info")
            if bill then bill:Destroy() end
        end
    end
end

-- Core Logic Loop (Auto Collect & Item ESP)
task.spawn(function()
    while true do
        if Config.AutoCollect then
            local lootFolder = Workspace:FindFirstChild("MyLoot")
            local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            
            if lootFolder and rootPart then
                local batch = {}
                for _, item in ipairs(lootFolder:GetChildren()) do
                    if not isMiniFridge(item) then
                        local prompt = item:FindFirstChild("ProximityPrompt", true)
                        local part = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or (item:IsA("BasePart") and item)
                        
                        if prompt and part then
                            local dist = (part.Position - rootPart.Position).Magnitude
                            local weight = tonumber(item:GetAttribute("Weight") or (item:FindFirstChild("Weight") and item.Weight.Value)) or 0
                            local value = tonumber(item:GetAttribute("Value") or (item:FindFirstChild("Value") and item.Value.Value)) or 0
                            
                            if dist <= Config.MaxDistance and value >= Config.MinValue and weight >= Config.MinWeight and weight <= Config.MaxWeight then
                                table.insert(batch, { Prompt = prompt, Weight = weight })
                            end
                        end
                    end
                end

                table.sort(batch, function(a, b) return a.Weight < b.Weight end)
                for _, data in ipairs(batch) do
                    if not Config.AutoCollect then break end
                    pcall(fireproximityprompt, data.Prompt)
                    task.wait(0.1)
                end
            end
        end

        local lootFolder = Workspace:FindFirstChild("MyLoot")
        if lootFolder then
            for _, item in ipairs(lootFolder:GetChildren()) do
                if item:IsA("Model") or item:IsA("BasePart") then
                    local itemNameLower = item.Name:lower()
                    local isScrewdriver = itemNameLower:find("screwdriver") or itemNameLower:find("screw driver") or (item.Name == "Screwdriver")
                    local isFridge = isMiniFridge(item)
                    
                    local weight = tonumber(item:GetAttribute("Weight") or (item:FindFirstChild("Weight") and item.Weight.Value)) or 0
                    local value = tonumber(item:GetAttribute("Value") or (item:FindFirstChild("Value") and item.Value.Value)) or 0
                    
                    if value == 0 and not item:GetAttribute("Value") and not item:FindFirstChild("Value") then
                        value = Config.MinValue
                    end

                    local inBounds = (value >= Config.MinValue and weight >= Config.MinWeight and weight <= Config.MaxWeight) or isScrewdriver

                    -- Apply Item ESP if enabled and not a mini fridge
                    if Config.ItemESP and inBounds and not isFridge then
                        toggleHighlight(item, true, Color3.fromRGB(255, 215, 0), "Item_ESP_HL", nil)
                        
                        local part = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or item
                        if part then
                            local bill = part:FindFirstChild("Item_ESP_Info")
                            if not bill then
                                bill = create("BillboardGui", { Name = "Item_ESP_Info", Size = UDim2.new(0, 120, 0, 50), StudsOffset = Vector3.new(0, 2.5, 0), AlwaysOnTop = true, Parent = part })
                                create("TextLabel", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(255, 255, 255), TextStrokeTransparency = 0, TextSize = 12, Font = Enum.Font.GothamBold, Parent = bill })
                            end
                            
                            local label = bill:FindFirstChildOfClass("TextLabel")
                            if label then
                                -- Color Tier Logic: Screwdriver (Blue) > Value >= 10000 (Black) > Value >= 1000 (Gold) > Default (White)
                                if isScrewdriver then
                                    label.TextColor3 = Color3.fromRGB(0, 150, 255)   -- Bright Blue
                                elseif value >= 10000 then
                                    label.TextColor3 = Color3.fromRGB(0, 0, 0)       -- Pure Black for $10,000+
                                elseif value >= 1000 then
                                    label.TextColor3 = Color3.fromRGB(255, 215, 0)   -- Gold for $1,000+
                                else
                                    label.TextColor3 = Color3.fromRGB(255, 255, 255) -- White
                                end

                                label.Text = string.format("%s\nW: %s | V: %s", item.Name, tostring(weight), tostring(value))
                            end
                        end
                    else
                        toggleHighlight(item, false, Color3.fromRGB(255, 215, 0), "Item_ESP_HL", nil)
                        local part = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or item
                        if part then
                            local bill = part:FindFirstChild("Item_ESP_Info")
                            if bill then bill:Destroy() end
                        end
                    end
                end
            end
        end
        task.wait(0.4)
    end
end)

-- Real-time ESP (Players & Monsters) & Enforcers
RunService.RenderStepped:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            
            local hasEntityChosen = (character:GetAttribute("EntityChosen") == true)
                or (player:GetAttribute("EntityChosen") == true)
                or (character:FindFirstChild("EntityChosen") ~= nil)
                or (player:FindFirstChild("EntityChosen") ~= nil)

            if Config.MonsterESP and hasEntityChosen then
                toggleHighlight(character, true, Color3.fromRGB(0, 255, 0), "Monster_ESP_HL", player.Name)
            else
                toggleHighlight(character, false, Color3.fromRGB(0, 255, 0), "Monster_ESP_HL", nil)
            end

            if Config.PlayerESP and not hasEntityChosen then
                toggleHighlight(character, true, Color3.fromRGB(255, 50, 50), "Player_ESP_HL", player.Name)
            else
                toggleHighlight(character, false, Color3.fromRGB(255, 50, 50), "Player_ESP_HL", nil)
            end
        end
    end

    -- AI Monster Detection list (Includes The Wendell, The Hollow, The Rictus, The Locust, and The Maternal Wraith)
    local aiMonsters = { "wendell", "hollow", "rictus", "locust", "maternal wraith", "wraith" }
    
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(obj) then
            local nameLower = obj.Name:lower()
            
            if not nameLower:find("menu") then
                local isAiMonster = false
                
                for _, entityName in ipairs(aiMonsters) do
                    if nameLower:find(entityName) then
                        isAiMonster = true
                        break
                    end
                end
                
                if not isAiMonster then
                    isAiMonster = (obj:GetAttribute("EntityChosen") == true)
                        or (obj:FindFirstChild("EntityChosen") ~= nil)
                        or (obj:GetAttribute("IsMonster") == true)
                        or nameLower:find("monster")
                        or nameLower:find("entity")
                end

                toggleHighlight(obj, Config.MonsterESP and isAiMonster, Color3.fromRGB(0, 255, 0), "Monster_ESP_HL", obj.Name)
            end
        end
    end

    if Config.ForceThirdPerson then
        if LocalPlayer.CameraMinZoomDistance < 10 then
            LocalPlayer.CameraMinZoomDistance = 10
            LocalPlayer.CameraMaxZoomDistance = math.max(LocalPlayer.CameraMaxZoomDistance, 10)
        end
    end

    if LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            if Config.SpeedEnabled then
                if humanoid.WalkSpeed ~= Config.SpeedValue then
                    humanoid.WalkSpeed = Config.SpeedValue
                end
            else
                if humanoid.WalkSpeed == Config.SpeedValue then
                    humanoid.WalkSpeed = 16
                end
            end
        end
    end
end)

-- NoClip Loop
RunService.Stepped:Connect(function()
    if Config.NoClip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)
