-- UI Component Builders
local function AddToggle(parentTab, text, initialState, callback)
    local btn = create("TextButton", {
        Size = UDim2.new(1, -13, 0, 30),
        BackgroundColor3 = initialState and Color3.fromRGB(0, 160, 110) or Color3.fromRGB(26, 26, 33),
        TextColor3 = initialState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 195),
        TextSize = 10,
        Font = Enum.Font.GothamMedium,
        Text = "   " .. text .. (initialState and ": ON" or ": OFF"),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = parentTab
    })
    create("UICorner", { CornerRadius = UDim.new(0, 5), Parent = btn })

    local active = initialState
    btn.MouseButton1Click:Connect(function()
        active = not active
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = active and Color3.fromRGB(0, 160, 110) or Color3.fromRGB(26, 26, 33),
            TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 195)
        }):Play()
        btn.Text = "   " .. text .. (active and ": ON" or ": OFF")
        callback(active)
    end)

    return {
        Set = function(state)
            active = state
            btn.BackgroundColor3 = active and Color3.fromRGB(0, 160, 110) or Color3.fromRGB(26, 26, 33)
            btn.TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 195)
            btn.Text = "   " .. text .. (active and ": ON" or ": OFF")
            callback(active)
        end
    }
end

