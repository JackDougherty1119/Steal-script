local ConfigFileName = "LootEspHub_Config.json"

local function SaveConfig()
    pcall(function()
        if writefile then
            local saveData = {
                MaxDistance = Config.MaxDistance,
                MinValue = Config.MinValue,
                MinWeight = Config.MinWeight,
                MaxWeight = Config.MaxWeight,
                SpeedValue = Config.SpeedValue,
                PresetValues = Config.PresetValues,
                Keybinds = {
                    ToggleGui = Config.Keybinds.ToggleGui.Name,
                    Val100 = Config.Keybinds.Val100.Name,
                    Val250 = Config.Keybinds.Val250.Name,
                    Val500 = Config.Keybinds.Val500.Name,
                    Val1000 = Config.Keybinds.Val1000.Name
                }
            }
            writefile(ConfigFileName, HttpService:JSONEncode(saveData))
        end
    end)
end

local function LoadConfig()
    pcall(function()
        if readfile and isfile and isfile(ConfigFileName) then
            local data = HttpService:JSONDecode(readfile(ConfigFileName))
            if data then
                Config.MaxDistance = data.MaxDistance or Config.MaxDistance
                Config.MinValue = data.MinValue or Config.MinValue
                Config.MinWeight = data.MinWeight or Config.MinWeight
                Config.MaxWeight = data.MaxWeight or Config.MaxWeight
                Config.SpeedValue = data.SpeedValue or Config.SpeedValue
                if data.PresetValues then
                    Config.PresetValues.Val1 = data.PresetValues.Val1 or Config.PresetValues.Val1
                    Config.PresetValues.Val2 = data.PresetValues.Val2 or Config.PresetValues.Val2
                    Config.PresetValues.Val3 = data.PresetValues.Val3 or Config.PresetValues.Val3
                    Config.PresetValues.Val4 = data.PresetValues.Val4 or Config.PresetValues.Val4
                end
                if data.Keybinds then
                    if data.Keybinds.ToggleGui then Config.Keybinds.ToggleGui = Enum.KeyCode[data.Keybinds.ToggleGui] or Config.Keybinds.ToggleGui end
                    if data.Keybinds.Val100 then Config.Keybinds.Val100 = Enum.KeyCode[data.Keybinds.Val100] or Config.Keybinds.Val100 end
                    if data.Keybinds.Val250 then Config.Keybinds.Val250 = Enum.KeyCode[data.Keybinds.Val250] or Config.Keybinds.Val250 end
                    if data.Keybinds.Val500 then Config.Keybinds.Val500 = Enum.KeyCode[data.Keybinds.Val500] or Config.Keybinds.Val500 end
                    if data.Keybinds.Val1000 then Config.Keybinds.Val1000 = Enum.KeyCode[data.Keybinds.Val1000] or Config.Keybinds.Val1000 end
                end
            end
        end
    end)
end

